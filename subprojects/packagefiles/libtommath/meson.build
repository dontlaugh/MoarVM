libtommath_lib = static_library('tommath',
  tommath_sources,
  include_directories: include_directories('.'),
)

libtommath_dep = declare_dependency(
  link_with: libtommath_lib,
  include_directories: include_directories('.'),
)

meson.override_dependency('libtommath', libtommath_dep)
